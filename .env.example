# ---------------------------------------------------------------------------
# Daraz AI Shopping Assistant -- example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Daraz AI Shopping Assistant"
APP_ENV=dev
APP_DEBUG=false

# --- API -------------------------------------------------------------------
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# --- Firecrawl (REQUIRED) --------------------------------------------------
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_RETRIES=2

# --- LLM (REQUIRED for POST /api/v1/chat and /api/v1/chat/stream) ----------
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-flash-lite-latest
LLM_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore  
LLM_TEMPERATURE=0.0

# --- Daraz -----------------------------------------------------------------
DARAZ_BASE_URL=https://www.daraz.pk
DARAZ_SEARCH_PATH=/catalog/
DARAZ_DEFAULT_CURRENCY=PKR
DARAZ_ITEMS_PER_PAGE=40

# --- Scraper ---------------------------------------------------------------
SCRAPER_DEFAULT_PAGE=1

# --- Scrape store (local JSON persistence for scraped payloads) ------------
SCRAPE_STORE_PATH=data/scrape_store.json
SCRAPE_STORE_SEARCH_TTL_SECONDS=21600
SCRAPE_STORE_PRODUCT_TTL_SECONDS=86400

# --- Voice (REQUIRED for GET /api/v1/voice/ws) -----------------------------
# Deepgram handles speech-to-text; ElevenLabs handles text-to-speech.
# Both keys are required for the voice WebSocket endpoint. If either is
# missing, the endpoint refuses the connection with a clear error.

DEEPGRAM_API_KEY=your-deepgram-key-here
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
STT_SAMPLE_RATE=16000

ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TTS_SAMPLE_RATE=24000

# Pre-synthesize the latency-masking filler phrases at startup. Costs a
# handful of ElevenLabs characters on every server boot. Off by default;
# turn on in production for the lowest first-turn latency.
VOICE_PREWARM_FILLERS=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
