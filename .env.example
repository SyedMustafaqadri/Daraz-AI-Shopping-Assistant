# ---------------------------------------------------------------------------
# Daraz AI Shopping Assistant -- example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Daraz AI Shopping Assistant"
APP_ENV=dev
APP_DEBUG=false

# --- API -------------------------------------------------------------------
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# --- Firecrawl (REQUIRED) --------------------------------------------------
FIRECRAWL_API_KEY=fc-your-key-here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_RETRIES=2

# --- LLM (REQUIRED for POST /api/v1/chat and /api/v1/chat/stream) ----------
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# --- Daraz -----------------------------------------------------------------
DARAZ_BASE_URL=https://www.daraz.pk
DARAZ_SEARCH_PATH=/catalog/
DARAZ_DEFAULT_CURRENCY=PKR
DARAZ_ITEMS_PER_PAGE=40

# --- Scraper ---------------------------------------------------------------
SCRAPER_DEFAULT_PAGE=1

# --- Scrape store (local JSON persistence for scraped payloads) ------------
# Search results and product details are cached here after a successful
# scrape. A repeat request for the same key returns the cached payload
# without calling Firecrawl. The file is created automatically on first
# run. Delete it to force a cold cache.
SCRAPE_STORE_PATH=data/scrape_store.json
SCRAPE_STORE_SEARCH_TTL_SECONDS=21600
SCRAPE_STORE_PRODUCT_TTL_SECONDS=86400

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
